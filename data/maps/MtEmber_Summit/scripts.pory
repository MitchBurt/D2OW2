raw `
MtEmber_Summit_MapScripts::
	.byte 0

//Remiel
MtEmber_Summit_EventScript_Remiel::
	lock
	faceplayer
	waitse
	playmoncry SPECIES_REMIEL, 2
	delay 40
	waitmoncry
	setflag FLAG_TOTEM_BATTLE
	setvar VAR_NUM_WILD_POKEMON_STAT_BOOST, 2
	setwildbattlewithcustommoves SPECIES_REMIEL, 70, ITEM_NONE, MOVE_FIRE_BLAST, MOVE_HURRICANE, MOVE_EXTRASENSORY, MOVE_ROOST, 2, NATURE_TIMID
	setflag FLAG_SYS_CTRL_OBJ_DELETE
	dowildbattle
	clearflag FLAG_SYS_CTRL_OBJ_DELETE
	specialvar VAR_RESULT, GetBattleOutcome
	compare VAR_RESULT, B_OUTCOME_CAUGHT
	goto_if_eq MtEmber_Summit_EventScript_CaughtRemiel
	compare VAR_RESULT, B_OUTCOME_WON
	goto_if_eq MtEmber_Summit_EventScript_RanFromRemiel
	compare VAR_RESULT, B_OUTCOME_RAN
	goto_if_eq MtEmber_Summit_EventScript_RanFromRemiel
	compare VAR_RESULT, B_OUTCOME_PLAYER_TELEPORTED
	goto_if_eq MtEmber_Summit_EventScript_RanFromRemiel
	setflag FLAG_DEFEATED_REMIEL
	release
	end

MtEmber_Summit_EventScript_CaughtRemiel::
	setflag FLAG_DEFEATED_REMIEL
	fadescreenswapbuffers FADE_TO_BLACK
	removeobject VAR_LAST_TALKED
	fadescreenswapbuffers FADE_FROM_BLACK
	release
	end

MtEmber_Summit_EventScript_DefeatedRemiel::
	fadescreenswapbuffers FADE_TO_BLACK
	removeobject VAR_LAST_TALKED
	fadescreenswapbuffers FADE_FROM_BLACK
	release
	end

MtEmber_Summit_EventScript_RanFromRemiel::
	setvar VAR_0x8004, SPECIES_REMIEL
	fadescreenswapbuffers FADE_TO_BLACK
	removeobject VAR_LAST_TALKED
	fadescreenswapbuffers FADE_FROM_BLACK
	bufferspeciesname 0, VAR_0x8004
	msgbox gText_LegendaryFlewAway, MSGBOX_DEFAULT
	release
	end
`
