raw `
RustboroCity_Gym_MapScripts:: @ 8212F30
	map_script MAP_SCRIPT_ON_LOAD, RustboroCity_Gym_EventScript_Set_Gym_Pokemon_Species

//First Team
RustboroCity_Gym_EventScript_Mason:: @ 8212F31
	lock
	faceplayer
	goto_if_set FLAG_BADGE01_GET, RustboroCity_Gym_EventScript_Mason_PostBattle
	//goto_if_set FLAG_HARD_MODE, RustboroCity_Gym_EventScript_Mason_Battle1
	//goto_if_set FLAG_NORMAL_MODE, RustboroCity_Gym_EventScript_Mason_Battle1
	trainerbattle_single TRAINER_MASON_1, RustboroCity_Gym_Text_MasonIntro, RustboroCity_Gym_Text_MasonDefeat, RustboroCity_Gym_EventScript_MasonDefeated, NO_MUSIC
	msgbox RustboroCity_Gym_Text_MasonPostBattle, MSGBOX_DEFAULT
	end
	
RustboroCity_Gym_EventScript_Mason_Battle1::
	goto_if_set FLAG_RECEIVED_BADGE_08, RustboroCity_Gym_EventScript_Mason_Battle5
	goto_if_set FLAG_RECEIVED_BADGE_07, RustboroCity_Gym_EventScript_Mason_Battle4
	goto_if_set FLAG_RECEIVED_BADGE_06, RustboroCity_Gym_EventScript_Mason_Battle4
	goto_if_set FLAG_RECEIVED_BADGE_05, RustboroCity_Gym_EventScript_Mason_Battle3
	goto_if_set FLAG_RECEIVED_BADGE_04, RustboroCity_Gym_EventScript_Mason_Battle3
	goto_if_set FLAG_RECEIVED_BADGE_03, RustboroCity_Gym_EventScript_Mason_Battle2
	goto_if_set FLAG_RECEIVED_BADGE_02, RustboroCity_Gym_EventScript_Mason_Battle2
	trainerbattle_single TRAINER_MASON_1, RustboroCity_Gym_Text_MasonIntro, RustboroCity_Gym_Text_MasonDefeat, RustboroCity_Gym_EventScript_MasonDefeated, NO_MUSIC
	msgbox RustboroCity_Gym_Text_MasonPostBattle, MSGBOX_DEFAULT
	end
	
	
//Second Team
RustboroCity_Gym_EventScript_Mason_Battle2::
	trainerbattle_single TRAINER_MASON_2, RustboroCity_Gym_Text_MasonIntro, RustboroCity_Gym_Text_MasonDefeat, RustboroCity_Gym_EventScript_MasonDefeated, NO_MUSIC
	msgbox RustboroCity_Gym_Text_MasonPostBattle, MSGBOX_DEFAULT
	end
	
//Third Team
RustboroCity_Gym_EventScript_Mason_Battle3::
	trainerbattle_single TRAINER_MASON_3, RustboroCity_Gym_Text_MasonIntro, RustboroCity_Gym_Text_MasonDefeat, RustboroCity_Gym_EventScript_MasonDefeated, NO_MUSIC
	msgbox RustboroCity_Gym_Text_MasonPostBattle, MSGBOX_DEFAULT
	end
	
//Fourth Team
RustboroCity_Gym_EventScript_Mason_Battle4::
	trainerbattle_single TRAINER_MASON_4, RustboroCity_Gym_Text_MasonIntro, RustboroCity_Gym_Text_MasonDefeat, RustboroCity_Gym_EventScript_MasonDefeated, NO_MUSIC
	msgbox RustboroCity_Gym_Text_MasonPostBattle, MSGBOX_DEFAULT
	end
	
//Fifth Team
RustboroCity_Gym_EventScript_Mason_Battle5::
	trainerbattle_single TRAINER_MASON_5, RustboroCity_Gym_Text_MasonIntro, RustboroCity_Gym_Text_MasonDefeat, RustboroCity_Gym_EventScript_MasonDefeated, NO_MUSIC
	msgbox RustboroCity_Gym_Text_MasonPostBattle, MSGBOX_DEFAULT
	end

	
RustboroCity_Gym_EventScript_Mason_PostBattle::
	goto_if_unset FLAG_MASON_REMATCH, RustboroCity_Gym_EventScript_MasonRematch
	msgbox RustboroCity_Gym_Text_MasonPostRematch, MSGBOX_DEFAULT
	release
	end
	
RustboroCity_Gym_EventScript_MasonRematch:: @ 8212FC8
	msgbox RustboroCity_Gym_Text_MasonPreRematch, MSGBOX_DEFAULT
	goto RustboroCity_Gym_EventScript_Start_Rematch_1
	end
	
RustboroCity_Gym_EventScript_MasonRematchEnd::
	msgbox RustboroCity_Gym_Text_MasonPostRematch, MSGBOX_AUTOCLOSE
	call Gym_EventScript_Reset_Random_Rematch
	setflag FLAG_MASON_REMATCH
	end
	
RustboroCity_Gym_EventScript_Start_Rematch_1::
	checkitem ITEM_TM39_ROCK_TOMB, 1
	compare VAR_RESULT, TRUE
	goto_if_eq RustboroCity_Gym_EventScript_Start_Rematch_2
	trainerbattle_no_intro TRAINER_MASON_1, RustboroCity_Gym_Text_MasonRematchDefeat
	msgbox RustboroCity_Gym_Text_GetTM, MSGBOX_DEFAULT
	giveitem ITEM_TM39_ROCK_TOMB
	goto RustboroCity_Gym_EventScript_MasonRematchEnd
	end
	
RustboroCity_Gym_EventScript_Start_Rematch_2::
	goto_if_unset FLAG_RECEIVED_TM08 RustboroCity_Gym_EventScript_Start_Rematch_Party_1
	checkitem ITEM_TM69_ROCK_POLISH, 1
	compare VAR_RESULT, TRUE
	goto_if_eq RustboroCity_Gym_EventScript_Start_Rematch_3
	trainerbattle_no_intro TRAINER_MASON_2, RustboroCity_Gym_Text_MasonRematchDefeat
	msgbox RustboroCity_Gym_Text_GetTM, MSGBOX_DEFAULT
	giveitem ITEM_TM69_ROCK_POLISH
	goto RustboroCity_Gym_EventScript_MasonRematchEnd
	end
	
RustboroCity_Gym_EventScript_Start_Rematch_3::
	goto_if_unset FLAG_RECEIVED_TM42 RustboroCity_Gym_EventScript_Start_Rematch_Party_2
	checkitem ITEM_TM110_STEALTH_ROCK, 1
	compare VAR_RESULT, TRUE
	goto_if_eq RustboroCity_Gym_EventScript_Start_Rematch_4
	trainerbattle_no_intro TRAINER_MASON_3, RustboroCity_Gym_Text_MasonRematchDefeat
	msgbox RustboroCity_Gym_Text_GetTM, MSGBOX_DEFAULT
	giveitem ITEM_TM110_STEALTH_ROCK
	goto RustboroCity_Gym_EventScript_MasonRematchEnd
	end
	
RustboroCity_Gym_EventScript_Start_Rematch_4::
	goto_if_unset FLAG_RECEIVED_TM40 RustboroCity_Gym_EventScript_Start_Rematch_Party_3
	checkitem ITEM_TM107_POWER_GEM, 1
	compare VAR_RESULT, TRUE
	goto_if_eq RustboroCity_Gym_EventScript_Start_Rematch_5
	trainerbattle_no_intro TRAINER_MASON_4, RustboroCity_Gym_Text_MasonRematchDefeat
	msgbox RustboroCity_Gym_Text_GetTM, MSGBOX_DEFAULT
	giveitem ITEM_TM107_POWER_GEM
	goto RustboroCity_Gym_EventScript_MasonRematchEnd
	end
	
RustboroCity_Gym_EventScript_Start_Rematch_5::
	goto_if_unset FLAG_RECEIVED_TM04 RustboroCity_Gym_EventScript_Start_Rematch_Party_4
	goto_if_set FLAG_GOT_VOIDITE RustboroCity_Gym_EventScript_Start_Rematch_6
	trainerbattle_no_intro TRAINER_MASON_4, RustboroCity_Gym_Text_MasonRematchDefeat
	msgbox RustboroCity_Gym_Text_GetMegaStone, MSGBOX_DEFAULT
	giveitem ITEM_VOIDITE
	setflag FLAG_GOT_VOIDITE
	goto RustboroCity_Gym_EventScript_MasonRematchEnd
	end
	
RustboroCity_Gym_EventScript_Start_Rematch_6::
	goto_if_unset FLAG_RECEIVED_TM03 RustboroCity_Gym_EventScript_Start_Rematch_Party_4
	checkitem ITEM_TM71_STONE_EDGE, 1
	compare VAR_RESULT, TRUE
	goto_if_eq RustboroCity_Gym_EventScript_Start_Rematch_Final
	trainerbattle_no_intro TRAINER_MASON_5, RustboroCity_Gym_Text_MasonRematchDefeat
	msgbox RustboroCity_Gym_Text_GetTM, MSGBOX_DEFAULT
	giveitem ITEM_TM71_STONE_EDGE
	goto RustboroCity_Gym_EventScript_MasonRematchEnd
	end
	
RustboroCity_Gym_EventScript_Start_Rematch_Final::
	random 5
	switch VAR_RESULT
	case 0, RustboroCity_Gym_EventScript_Start_Rematch_Party_1
	case 1, RustboroCity_Gym_EventScript_Start_Rematch_Party_2
	case 2, RustboroCity_Gym_EventScript_Start_Rematch_Party_3
	case 3, RustboroCity_Gym_EventScript_Start_Rematch_Party_4
	case 4, RustboroCity_Gym_EventScript_Start_Rematch_Party_5
	end
	
RustboroCity_Gym_EventScript_Start_Rematch_Party_1::
	trainerbattle_no_intro TRAINER_MASON_1, RustboroCity_Gym_Text_MasonRematchDefeat
	goto_if_unset FLAG_RECEIVED_TM04, RustboroCity_Gym_EventScript_MasonRematchEnd
	msgbox RustboroCity_Gym_Text_GetReward, MSGBOX_DEFAULT
	giveitem ITEM_BOLD_MINT, 3
	goto RustboroCity_Gym_EventScript_MasonRematchEnd
	end
	
RustboroCity_Gym_EventScript_Start_Rematch_Party_2::
	trainerbattle_no_intro TRAINER_MASON_2, RustboroCity_Gym_Text_MasonRematchDefeat
	goto_if_unset FLAG_RECEIVED_TM04, RustboroCity_Gym_EventScript_MasonRematchEnd
	msgbox RustboroCity_Gym_Text_GetReward, MSGBOX_DEFAULT
	giveitem ITEM_IMPISH_MINT, 3
	goto RustboroCity_Gym_EventScript_MasonRematchEnd
	end
	
RustboroCity_Gym_EventScript_Start_Rematch_Party_3::
	trainerbattle_no_intro TRAINER_MASON_3, RustboroCity_Gym_Text_MasonRematchDefeat
	goto_if_unset FLAG_RECEIVED_TM04, RustboroCity_Gym_EventScript_MasonRematchEnd
	msgbox RustboroCity_Gym_Text_GetReward, MSGBOX_DEFAULT
	giveitem ITEM_LAX_MINT, 3
	goto RustboroCity_Gym_EventScript_MasonRematchEnd
	end
	
RustboroCity_Gym_EventScript_Start_Rematch_Party_4::
	trainerbattle_no_intro TRAINER_MASON_4, RustboroCity_Gym_Text_MasonRematchDefeat
	goto_if_unset FLAG_RECEIVED_TM04, RustboroCity_Gym_EventScript_MasonRematchEnd
	msgbox RustboroCity_Gym_Text_GetReward, MSGBOX_DEFAULT
	giveitem ITEM_RELAXED_MINT, 3
	goto RustboroCity_Gym_EventScript_MasonRematchEnd
	end
	
RustboroCity_Gym_EventScript_Start_Rematch_Party_5::
	trainerbattle_no_intro TRAINER_MASON_5, RustboroCity_Gym_Text_MasonRematchDefeat
	goto_if_unset FLAG_RECEIVED_TM04, RustboroCity_Gym_EventScript_MasonRematchEnd
	msgbox RustboroCity_Gym_Text_GetReward, MSGBOX_DEFAULT
	giveitem ITEM_ADAMANT_MINT, 3
	goto RustboroCity_Gym_EventScript_MasonRematchEnd
	end

RustboroCity_Gym_EventScript_MasonDefeated:: @ 8212F66
	message RustboroCity_Gym_Text_ReceivedStoneBadge
	waitmessage
	call Common_EventScript_PlayGymBadgeFanfare
	msgbox RustboroCity_Gym_Text_StoneBadgeInfoTakeThis, MSGBOX_DEFAULT
	setflag FLAG_DEFEATED_RUSTBORO_GYM
	setflag FLAG_BADGE01_GET
	call Special_Gym_EventScript_Give_Item
	call RustboroCity_Gym_EventScript_GiveRockTomb
	closemessage
	delay 30
	setvar VAR_0x8008, 1
	call Common_EventScript_SetGymTrainers
	waitfanfare
	closemessage
	delay 30
	playfanfare MUS_REGISTER_MATCH_CALL
	msgbox RustboroCity_Gym_Text_RegisteredMason, MSGBOX_DEFAULT
	waitfanfare
	closemessage
	delay 30
	setflag FLAG_ENABLE_MASON_MATCH_CALL
	call Gym_EventScript_Reset_Rematches
	setflag FLAG_MASON_REMATCH
	release
	end

RustboroCity_Gym_EventScript_GiveRockTomb:: @ 8212FA4
	msgbox Gym_Text_Takethis2, MSGBOX_DEFAULT
	giveitem ITEM_TM39
	msgbox RustboroCity_Gym_Text_ExplainRockTomb, MSGBOX_DEFAULT
	return

RustboroCity_Gym_EventScript_Josh:: @ 8212FE3
	trainerbattle_single TRAINER_JOSH, RustboroCity_Gym_Text_JoshIntro, RustboroCity_Gym_Text_JoshDefeat
	msgbox RustboroCity_Gym_Text_JoshPostBattle, MSGBOX_AUTOCLOSE
	end

RustboroCity_Gym_EventScript_Tommy:: @ 8212FFA
	trainerbattle_single TRAINER_TOMMY, RustboroCity_Gym_Text_TommyIntro, RustboroCity_Gym_Text_TommyDefeat
