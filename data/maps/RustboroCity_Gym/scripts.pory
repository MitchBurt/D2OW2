			case 5: trainerbattle_no_intro(TRAINER_MASON_3, RustboroCity_Gym_Text_MasonRematchDefeat)
			case 6: trainerbattle_no_intro(TRAINER_MASON_4, RustboroCity_Gym_Text_MasonRematchDefeat)
			case 7: trainerbattle_no_intro(TRAINER_MASON_4, RustboroCity_Gym_Text_MasonRematchDefeat)
			default:
				if(flag(FLAG_SYS_GAME_CLEAR)){
					//When you beat the game you can get a random rematch each day
					random(5)
					switch (var(VAR_RESULT)) {
						case 0: trainerbattle_no_intro(TRAINER_MASON_1, RustboroCity_Gym_Text_MasonRematchDefeat)
