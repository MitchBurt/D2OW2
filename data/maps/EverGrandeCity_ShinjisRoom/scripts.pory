raw `
EverGrandeCity_ShinjisRoom_MapScripts:: @ 822869C
	map_script MAP_SCRIPT_ON_FRAME_TABLE, EverGrandeCity_ShinjisRoom_OnFrame
	map_script MAP_SCRIPT_ON_LOAD, EverGrandeCity_ShinjisRoom_OnLoad
	map_script MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE, EverGrandeCity_JacksRoom_OnWarp
	.byte 0

@ Unused, Shinji uses Jacks identical OnWarp for some reason
EverGrandeCity_ShinjisRoom_OnWarp: @ 82286AC
	map_script_2 VAR_TEMP_1, 0, EverGrandeCity_ShinjisRoom_EventScript_PlayerTurnNorth
	.2byte 0

EverGrandeCity_ShinjisRoom_EventScript_PlayerTurnNorth:: @ 82286B6
	turnobject OBJ_EVENT_ID_PLAYER, DIR_NORTH
	end

EverGrandeCity_ShinjisRoom_OnFrame: @ 82286BB
	map_script_2 VAR_ELITE_4_STATE, 3, EverGrandeCity_ShinjisRoom_EventScript_WalkInCloseDoor
	.2byte 0

EverGrandeCity_ShinjisRoom_EventScript_WalkInCloseDoor:: @ 82286C5
	lockall
	call PokemonLeague_EliteFour_EventScript_WalkInCloseDoor
	setvar VAR_ELITE_4_STATE, 4
	releaseall
	end

EverGrandeCity_ShinjisRoom_OnLoad: @ 82286D2
	call_if_set FLAG_DEFEATED_ELITE_4_SHINJI, EverGrandeCity_ShinjisRoom_EventScript_ResetAdvanceToNextRoom
	compare VAR_ELITE_4_STATE, 4
	call_if_eq EverGrandeCity_ShinjisRoom_EventScript_CloseDoor
	end

EverGrandeCity_ShinjisRoom_EventScript_ResetAdvanceToNextRoom:: @ 82286E7
	call PokemonLeague_EliteFour_EventScript_ResetAdvanceToNextRoom
	return

EverGrandeCity_ShinjisRoom_EventScript_CloseDoor:: @ 82286ED
	call PokemonLeague_EliteFour_EventScript_CloseDoor
	return

EverGrandeCity_ShinjisRoom_EventScript_Shinji:: @ 82286F3
	lock
	faceplayer
	goto_if_set FLAG_DEFEATED_ELITE_4_SHINJI, EverGrandeCity_ShinjisRoom_EventScript_PostBattleSpeech
	playbgm MUS_ENCOUNTER_ELITE_FOUR, 0
	msgbox EverGrandeCity_ShinjisRoom_Text_IntroSpeech, MSGBOX_DEFAULT
	trainerbattle_no_intro TRAINER_SHINJI, EverGrandeCity_ShinjisRoom_Text_Defeat
	goto EverGrandeCity_ShinjisRoom_EventScript_Defeated
	end

EverGrandeCity_ShinjisRoom_EventScript_PostBattleSpeech:: @ 822871A
	msgbox EverGrandeCity_ShinjisRoom_Text_PostBattleSpeech, MSGBOX_DEFAULT
	release
	end

EverGrandeCity_ShinjisRoom_EventScript_Defeated:: @ 8228724
	setvar VAR_0x8004, FANCOUNTER_DEFEATED_SHINJI
	special Script_TryGainNewFanFromCounter
	setflag FLAG_DEFEATED_ELITE_4_SHINJI
	call PokemonLeague_EliteFour_SetAdvanceToNextRoomMetatiles
	msgbox EverGrandeCity_ShinjisRoom_Text_PostBattleSpeech, MSGBOX_DEFAULT
	release
	end

EverGrandeCity_ShinjisRoom_Text_IntroSpeech: @ 822873E
	.string "I didn't even want to do this...\n"
	.string "but, here I am anyway.\n"
	.string "Let's just get this over with.\p"
	.string "Maybe if I win, I'll feel...\n"
	.string "something. I don't know.$"

EverGrandeCity_ShinjisRoom_Text_Defeat: @ 8228895
	.string "I don't recognize this ceiling..$"

EverGrandeCity_ShinjisRoom_Text_PostBattleSpeech: @ 82288B0
	.string "I knew it... I'm just not\n"
	.string "cut out for this. I don't\n"
	.string "know why I even tried.$"
`
