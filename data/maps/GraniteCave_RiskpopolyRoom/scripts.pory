raw `
GraniteCave_RiskpopolyRoom_MapScripts::
	.byte 0

GraniteCave_RiskpopolyRoom_EventScript_Diance::
	lock
	faceplayer
	waitse
	playmoncry SPECIES_RISKPOPOLY, 2
	delay 40
	waitmoncry
	setflag FLAG_TOTEM_BATTLE
	setvar VAR_NUM_WILD_POKEMON_STAT_BOOST, 2
	setwildbattlewithcustommoves SPECIES_RISKPOPOLY, 70, ITEM_NONE, MOVE_PAY_DAY, MOVE_MOONBLAST, MOVE_GIGA_IMPACT, MOVE_PSYCHIC, 2, NATURE_TIMID
	setflag FLAG_SYS_CTRL_OBJ_DELETE
	dowildbattle
	clearflag FLAG_SYS_CTRL_OBJ_DELETE
	specialvar VAR_RESULT, GetBattleOutcome
	compare VAR_RESULT, B_OUTCOME_CAUGHT
	goto_if_eq GraniteCave_RiskpopolyRoom_EventScript_CaughtDiance
	compare VAR_RESULT, B_OUTCOME_WON
	goto_if_eq GraniteCave_RiskpopolyRoom_EventScript_RanFromDiance
	compare VAR_RESULT, B_OUTCOME_RAN
	goto_if_eq GraniteCave_RiskpopolyRoom_EventScript_RanFromDiance
	compare VAR_RESULT, B_OUTCOME_PLAYER_TELEPORTED
	goto_if_eq GraniteCave_RiskpopolyRoom_EventScript_RanFromDiance
	setflag FLAG_DEFEATED_RISKPOPOLY
	release
	end
	
GraniteCave_RiskpopolyRoom_EventScript_CaughtDiance::
	giveitem ITEM_SHEPEIRDITE
	setflag FLAG_DEFEATED_RISKPOPOLY
	fadescreenswapbuffers FADE_TO_BLACK
	removeobject VAR_LAST_TALKED
	fadescreenswapbuffers FADE_FROM_BLACK
	release
	end

GraniteCave_RiskpopolyRoom_EventScript_DefeatedDiance::
	fadescreenswapbuffers FADE_TO_BLACK
	removeobject VAR_LAST_TALKED
	fadescreenswapbuffers FADE_FROM_BLACK
	release
	end

GraniteCave_RiskpopolyRoom_EventScript_RanFromDiance::
	setvar VAR_0x8004, SPECIES_RISKPOPOLY
	fadescreenswapbuffers FADE_TO_BLACK
	removeobject VAR_LAST_TALKED
	fadescreenswapbuffers FADE_FROM_BLACK
	bufferspeciesname 0, VAR_0x8004
	msgbox gText_LegendaryFlewAway, MSGBOX_DEFAULT
	release
	end
`
