raw `
ArtisanCave_B1F_MapScripts:: @ 823AFAD
	map_script MAP_SCRIPT_ON_TRANSITION, ArtisanCave_B1F_OnTransition
	.byte 0

ArtisanCave_B1F_OnTransition: @ 823AFB3
	setflag FLAG_LANDMARK_ARTISAN_CAVE
	end

ArtisanCave_B1F_EventScript_Thiscraker::
	lock
	faceplayer
	waitse
	playmoncry SPECIES_THISCRAKER, 2
	delay 40
	waitmoncry
	setflag FLAG_TOTEM_BATTLE
	setvar VAR_NUM_WILD_POKEMON_STAT_BOOST, 3
	setwildbattlewithcustommoves SPECIES_THISCRAKER, 70, ITEM_KINGS_ROCK, MOVE_ZEN_HEADBUTT, MOVE_IRON_HEAD, MOVE_FIRE_PUNCH, MOVE_PLAY_ROUGH, 0, NATURE_JOLLY
	setflag FLAG_SYS_CTRL_OBJ_DELETE
	dowildbattle
	clearflag FLAG_SYS_CTRL_OBJ_DELETE
	specialvar VAR_RESULT, GetBattleOutcome
	compare VAR_RESULT, B_OUTCOME_CAUGHT
	goto_if_eq ArtisanCave_B1F_EventScript_CaughtThiscraker
	compare VAR_RESULT, B_OUTCOME_WON
	goto_if_eq ArtisanCave_B1F_EventScript_RanFromThiscraker
	compare VAR_RESULT, B_OUTCOME_RAN
	goto_if_eq ArtisanCave_B1F_EventScript_RanFromThiscraker
	compare VAR_RESULT, B_OUTCOME_PLAYER_TELEPORTED
	goto_if_eq ArtisanCave_B1F_EventScript_RanFromThiscraker
	setflag FLAG_DEFEATED_THISCRAKER
	release
	end
	ArtisanCave_B1F_EventScript_CaughtThiscraker::
	setflag FLAG_DEFEATED_THISCRAKER
	fadescreenswapbuffers FADE_TO_BLACK
	removeobject VAR_LAST_TALKED
	fadescreenswapbuffers FADE_FROM_BLACK
	release
	end
ArtisanCave_B1F_EventScript_DefeatedThiscraker::
	fadescreenswapbuffers FADE_TO_BLACK
	removeobject VAR_LAST_TALKED
	fadescreenswapbuffers FADE_FROM_BLACK
	release
	end
ArtisanCave_B1F_EventScript_RanFromThiscraker::
	setvar VAR_0x8004, SPECIES_THISCRAKER
	fadescreenswapbuffers FADE_TO_BLACK
	removeobject VAR_LAST_TALKED
	fadescreenswapbuffers FADE_FROM_BLACK
	bufferspeciesname 0, VAR_0x8004
	msgbox gText_LegendaryFlewAway, MSGBOX_DEFAULT
	release
	end

ArtisanCave_B1F_Text_Thiscraker::
	.string "Gwogobo weobobobo!$"
`
