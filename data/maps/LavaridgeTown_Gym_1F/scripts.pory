			case 6: trainerbattle_no_intro(TRAINER_JARED_4, LavaridgeTown_Gym_1F_Text_JaredRematchDefeat)
			case 7: trainerbattle_no_intro(TRAINER_JARED_4, LavaridgeTown_Gym_1F_Text_JaredRematchDefeat)
			default:
				if(flag(FLAG_SYS_GAME_CLEAR)){
					//When you beat the game you can get a random rematch each day
					random(5)
