						case 0: trainerbattle_no_intro(TRAINER_JARED_1, LavaridgeTown_Gym_1F_Text_JaredRematchDefeat)
						case 1: trainerbattle_no_intro(TRAINER_JARED_2, LavaridgeTown_Gym_1F_Text_JaredRematchDefeat)
