raw `
EverGrandeCity_JacksRoom_MapScripts:: @ 8227F01
	map_script MAP_SCRIPT_ON_LOAD, EverGrandeCity_JacksRoom_OnLoad
	map_script MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE, EverGrandeCity_JacksRoom_OnWarp
	map_script MAP_SCRIPT_ON_TRANSITION, EverGrandeCity_JacksRoom_OnTransition
	map_script MAP_SCRIPT_ON_FRAME_TABLE, EverGrandeCity_JacksRoom_OnFrame
	.byte 0

EverGrandeCity_JacksRoom_OnTransition: @ 8227F16
	setflag FLAG_MET_SCOTT_IN_EVERGRANDE
	setflag FLAG_HIDE_EVER_GRANDE_POKEMON_CENTER_1F_SCOTT
	end

EverGrandeCity_JacksRoom_OnLoad: @ 8227F1D
	call_if_set FLAG_DEFEATED_ELITE_4_JACK, EverGrandeCity_JacksRoom_EventScript_ResetAdvanceToNextRoom
	compare VAR_ELITE_4_STATE, 1
	call_if_eq EverGrandeCity_JacksRoom_EventScript_CloseDoor
	end

EverGrandeCity_JacksRoom_EventScript_ResetAdvanceToNextRoom:: @ 8227F32
	call PokemonLeague_EliteFour_EventScript_ResetAdvanceToNextRoom
	return

EverGrandeCity_JacksRoom_EventScript_CloseDoor:: @ 8227F38
	call PokemonLeague_EliteFour_EventScript_CloseDoor
	return

EverGrandeCity_JacksRoom_OnWarp: @ 8227F3E
	map_script_2 VAR_TEMP_1, 0, EverGrandeCity_JacksRoom_EventScript_PlayerTurnNorth
	.2byte 0

EverGrandeCity_JacksRoom_EventScript_PlayerTurnNorth:: @ 8227F48
	turnobject OBJ_EVENT_ID_PLAYER, DIR_NORTH
	end

EverGrandeCity_JacksRoom_OnFrame: @ 8227F4D
	map_script_2 VAR_ELITE_4_STATE, 0, EverGrandeCity_JacksRoom_EventScript_WalkInCloseDoor
	.2byte 0

EverGrandeCity_JacksRoom_EventScript_WalkInCloseDoor:: @ 8227F57
	lockall
	call PokemonLeague_EliteFour_EventScript_WalkInCloseDoor
	setvar VAR_ELITE_4_STATE, 1
	releaseall
	end

EverGrandeCity_JacksRoom_EventScript_Jack:: @ 8227F64
	lock
	faceplayer
	goto_if_set FLAG_DEFEATED_ELITE_4_JACK, EverGrandeCity_JacksRoom_EventScript_PostBattleSpeech
	playbgm MUS_ENCOUNTER_ELITE_FOUR, 0
	msgbox EverGrandeCity_JacksRoom_Text_IntroSpeech, MSGBOX_DEFAULT
	trainerbattle_no_intro TRAINER_JACK, EverGrandeCity_JacksRoom_Text_Defeat
	goto EverGrandeCity_JacksRoom_EventScript_Defeated
	end

EverGrandeCity_JacksRoom_EventScript_PostBattleSpeech:: @ 8227F8B
	msgbox EverGrandeCity_JacksRoom_Text_PostBattleSpeech, MSGBOX_DEFAULT
	release
	end

EverGrandeCity_JacksRoom_EventScript_Defeated:: @ 8227F95
	setflag FLAG_DEFEATED_ELITE_4_JACK
	call PokemonLeague_EliteFour_SetAdvanceToNextRoomMetatiles
	msgbox EverGrandeCity_JacksRoom_Text_PostBattleSpeech, MSGBOX_DEFAULT
	release
	end

EverGrandeCity_JacksRoom_Text_IntroSpeech: @ 8227FA7
	.string "Well, look who stumbled in!\n"
	.string "You ready to taste defeat,\n"
	.string "or just here for a good time?\p"
	.string "Either way, bottoms up!\n"
	.string "I hope you can handle the burn.$"

EverGrandeCity_JacksRoom_Text_Defeat: @ 82280A2
	.string "Heh... guess you held your own.\n"
	.string "Eh, it was fun, so it doesn't matter.$"

EverGrandeCity_JacksRoom_Text_PostBattleSpeech: @ 82280EC
	.string "Well, I'll be! You sure know\n"
	.string "how to handle yourself.\n"
	.string "Next round's on me.$"

`
