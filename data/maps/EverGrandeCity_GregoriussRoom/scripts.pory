raw `
EverGrandeCity_GregoriussRoom_MapScripts:: @ 8228174
	map_script MAP_SCRIPT_ON_LOAD, EverGrandeCity_GregoriussRoom_OnLoad
	map_script MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE, EverGrandeCity_GregoriussRoom_OnWarp
	map_script MAP_SCRIPT_ON_FRAME_TABLE, EverGrandeCity_GregoriussRoom_OnFrame
	.byte 0

EverGrandeCity_GregoriussRoom_OnWarp: @ 8228184
	map_script_2 VAR_TEMP_1, 0, EverGrandeCity_GregoriussRoom_EventScript_PlayerTurnNorth
	.2byte 0

EverGrandeCity_GregoriussRoom_EventScript_PlayerTurnNorth:: @ 822818E
	turnobject OBJ_EVENT_ID_PLAYER, DIR_NORTH
	end

EverGrandeCity_GregoriussRoom_OnFrame: @ 8228193
	map_script_2 VAR_ELITE_4_STATE, 1, EverGrandeCity_GregoriussRoom_EventScript_WalkInCloseDoor
	.2byte 0

EverGrandeCity_GregoriussRoom_EventScript_WalkInCloseDoor:: @ 822819D
	lockall
	call PokemonLeague_EliteFour_EventScript_WalkInCloseDoor
	setvar VAR_ELITE_4_STATE, 2
	releaseall
	end

EverGrandeCity_GregoriussRoom_OnLoad: @ 82281AA
	call_if_set FLAG_DEFEATED_ELITE_4_GREGORIUS, EverGrandeCity_GregoriussRoom_EventScript_ResetAdvanceToNextRoom
	compare VAR_ELITE_4_STATE, 2
	call_if_eq EverGrandeCity_GregoriussRoom_EventScript_CloseDoor
	end

EverGrandeCity_GregoriussRoom_EventScript_ResetAdvanceToNextRoom:: @ 82281BF
	call PokemonLeague_EliteFour_EventScript_ResetAdvanceToNextRoom
	return

EverGrandeCity_GregoriussRoom_EventScript_CloseDoor:: @ 82281C5
	call PokemonLeague_EliteFour_EventScript_CloseDoor
	return

EverGrandeCity_GregoriussRoom_EventScript_Gregorius:: @ 82281CB
	lock
	faceplayer
	goto_if_set FLAG_DEFEATED_ELITE_4_GREGORIUS, EverGrandeCity_GregoriussRoom_EventScript_PostBattleSpeech
	playbgm MUS_ENCOUNTER_ELITE_FOUR, 0
	msgbox EverGrandeCity_GregoriussRoom_Text_IntroSpeech, MSGBOX_DEFAULT
	trainerbattle_no_intro TRAINER_GREGORIUS, EverGrandeCity_GregoriussRoom_Text_Defeat
	goto EverGrandeCity_GregoriussRoom_EventScript_Defeated
	end

EverGrandeCity_GregoriussRoom_EventScript_PostBattleSpeech:: @ 82281F2
	msgbox EverGrandeCity_GregoriussRoom_Text_PostBattleSpeech, MSGBOX_DEFAULT
	release
	end

EverGrandeCity_GregoriussRoom_EventScript_Defeated:: @ 82281FC
	setflag FLAG_DEFEATED_ELITE_4_GREGORIUS
	call PokemonLeague_EliteFour_SetAdvanceToNextRoomMetatiles
	msgbox EverGrandeCity_GregoriussRoom_Text_PostBattleSpeech, MSGBOX_DEFAULT
	release
	end

EverGrandeCity_GregoriussRoom_Text_IntroSpeech: @ 822820E
	.string "Welcome, challenger.\n"
	.string "If you're here for a quick win,\n"
	.string "you've come to the wrong place.$"

EverGrandeCity_GregoriussRoom_Text_Defeat: @ 8228325
	.string "Oh, darn.\n"
	.string "I've gone and lost.$"

EverGrandeCity_GregoriussRoom_Text_PostBattleSpeech: @ 8228343
	.string "Impressive... you really\n"
	.string "worked through all that.\n"
	.string "Maybe there's hope for you yet.$"

`
