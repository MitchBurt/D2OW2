raw `
SootopolisCity_LotadAndSobbleafHouse_MapScripts:: @ 822722A
	.byte 0

SootopolisCity_LotadAndSobbleafHouse_EventScript_SobbleafBrother:: @ 822722B
	special GetSobbleafSizeRecordInfo
	lock
	faceplayer
	msgbox SootopolisCity_LotadAndSobbleafHouse_Text_PleaseShowMeBigSobbleaf, MSGBOX_DEFAULT
	special ChoosePartyMon
	waitstate
	copyvar VAR_RESULT, VAR_0x8004
	compare VAR_RESULT, 255
	goto_if_eq SootopolisCity_LotadAndSobbleafHouse_EventScript_CancelShowSobbleaf
	special CompareSobbleafSize
	compare VAR_RESULT, 1
	goto_if_eq SootopolisCity_LotadAndSobbleafHouse_EventScript_NotSobbleaf
	compare VAR_RESULT, 2
	goto_if_eq SootopolisCity_LotadAndSobbleafHouse_EventScript_SmallSobbleaf
	compare VAR_RESULT, 3
	goto_if_eq SootopolisCity_LotadAndSobbleafHouse_EventScript_BigSobbleaf
	release
	end

SootopolisCity_LotadAndSobbleafHouse_EventScript_CancelShowSobbleaf:: @ 8227272
	msgbox SootopolisCity_LotadAndSobbleafHouse_Text_DontHaveBigSobbleaf, MSGBOX_DEFAULT
	release
	end

SootopolisCity_LotadAndSobbleafHouse_EventScript_NotSobbleaf:: @ 822727C
	msgbox SootopolisCity_LotadAndSobbleafHouse_Text_ThatsNotSobbleaf, MSGBOX_DEFAULT
	release
	end

SootopolisCity_LotadAndSobbleafHouse_EventScript_SmallSobbleaf:: @ 8227286
	msgbox SootopolisCity_LotadAndSobbleafHouse_Text_SeenBiggerSobbleaf, MSGBOX_DEFAULT
	release
	end

SootopolisCity_LotadAndSobbleafHouse_EventScript_BigSobbleaf:: @ 8227290
	msgbox SootopolisCity_LotadAndSobbleafHouse_Text_GoshMightBeBiggerThanLotad, MSGBOX_DEFAULT
	giveitem ITEM_ELIXIR
	compare VAR_RESULT, FALSE
	goto_if_eq SootopolisCity_LotadAndSobbleafHouse_EventScript_NoRoomForElixir1
	closemessage
	release
	end

SootopolisCity_LotadAndSobbleafHouse_EventScript_NoRoomForElixir1:: @ 82272B2
	msgbox SootopolisCity_LotadAndSobbleafHouse_Text_BagCrammedFull1, MSGBOX_DEFAULT
	release
	end

SootopolisCity_LotadAndSobbleafHouse_EventScript_LotadBrother:: @ 82272BC
	special GetLotadSizeRecordInfo
	lock
	faceplayer
	msgbox SootopolisCity_LotadAndSobbleafHouse_Text_PleaseShowMeBigLotad, MSGBOX_DEFAULT
	special ChoosePartyMon
	waitstate
	copyvar VAR_RESULT, VAR_0x8004
	compare VAR_RESULT, 255
	goto_if_eq SootopolisCity_LotadAndSobbleafHouse_EventScript_CancelShowLotad
	special CompareLotadSize
	compare VAR_RESULT, 1
	goto_if_eq SootopolisCity_LotadAndSobbleafHouse_EventScript_NotLotad
	compare VAR_RESULT, 2
	goto_if_eq SootopolisCity_LotadAndSobbleafHouse_EventScript_SmallLotad
	compare VAR_RESULT, 3
	goto_if_eq SootopolisCity_LotadAndSobbleafHouse_EventScript_BigLotad
	release
	end

SootopolisCity_LotadAndSobbleafHouse_EventScript_CancelShowLotad:: @ 8227303
	msgbox SootopolisCity_LotadAndSobbleafHouse_Text_DontHaveBigLotad, MSGBOX_DEFAULT
	release
	end

SootopolisCity_LotadAndSobbleafHouse_EventScript_NotLotad:: @ 822730D
	msgbox SootopolisCity_LotadAndSobbleafHouse_Text_ThatsNotLotad, MSGBOX_DEFAULT
	release
	end

SootopolisCity_LotadAndSobbleafHouse_EventScript_SmallLotad:: @ 8227317
	msgbox SootopolisCity_LotadAndSobbleafHouse_Text_SeenBiggerLotad, MSGBOX_DEFAULT
	release
	end

SootopolisCity_LotadAndSobbleafHouse_EventScript_BigLotad:: @ 8227321
	msgbox SootopolisCity_LotadAndSobbleafHouse_Text_WowMightBeBiggerThanSobbleaf, MSGBOX_DEFAULT
	giveitem ITEM_ELIXIR
	compare VAR_RESULT, FALSE
	goto_if_eq SootopolisCity_LotadAndSobbleafHouse_EventScript_NoRoomForElixir2
	closemessage
	release
	end

SootopolisCity_LotadAndSobbleafHouse_EventScript_NoRoomForElixir2:: @ 8227343
	msgbox SootopolisCity_LotadAndSobbleafHouse_Text_BagCrammedFull2, MSGBOX_DEFAULT
	release
	end

SootopolisCity_LotadAndSobbleafHouse_EventScript_SobbleafSizeRecord:: @ 822734D
	special GetSobbleafSizeRecordInfo
	lockall
	msgbox SootopolisCity_LotadAndSobbleafHouse_Text_BiggestSobbleafInHistory, MSGBOX_DEFAULT
	releaseall
	end

SootopolisCity_LotadAndSobbleafHouse_EventScript_LotadSizeRecord:: @ 822735B
	special GetLotadSizeRecordInfo
	lockall
	msgbox SootopolisCity_LotadAndSobbleafHouse_Text_BiggestLotadInHistory, MSGBOX_DEFAULT
	releaseall
	end

SootopolisCity_LotadAndSobbleafHouse_Text_PleaseShowMeBigSobbleaf: @ 8227369
	.string "Do you know the Pokémon Sobbleaf?\n"
	.string "It's hardly ever seen in Sootopolis.\p"
	.string "Anyway, I love big Sobbleaf.\n"
	.string "The bigger the better.\p"
	.string "But my younger brother, he says that\n"
	.string "Lotad is bigger.\p"
	.string "That's silly.\n"
	.string "Sobbleaf has to be bigger than that!\p"
	.string "Huh? Do you have a Sobbleaf with you?\n"
	.string "P-p-please, show me!$"

SootopolisCity_LotadAndSobbleafHouse_Text_GoshMightBeBiggerThanLotad: @ 8227480
	.string "{STR_VAR_2} inches!\n"
	.string "Oh, my gosh, this is a big one!\p"
	.string "It might even beat the big Lotad\n"
	.string "my younger brother saw!\p"
	.string "Thanks for showing me.\n"
	.string "This is my thanks!$"

@ Unused
SootopolisCity_LotadAndSobbleafHouse_Text_ReceivedPotion1: @ 822750E
	.string "{PLAYER} received a Potion.$"

SootopolisCity_LotadAndSobbleafHouse_Text_BagCrammedFull1: @ 8227524
	.string "Hunh?\n"
	.string "Your Bag is crammed full.$"

SootopolisCity_LotadAndSobbleafHouse_Text_SeenBiggerSobbleaf: @ 8227544
	.string "{STR_VAR_2} inches, is it?\p"
	.string "Hmm… I've seen a bigger Sobbleaf\n"
	.string "than this one.$"

SootopolisCity_LotadAndSobbleafHouse_Text_ThatsNotSobbleaf: @ 8227584
	.string "Oh, now this is quite something…\n"
	.string "But it's not a Sobbleaf!$"

SootopolisCity_LotadAndSobbleafHouse_Text_DontHaveBigSobbleaf: @ 82275BC
	.string "You don't have a big Sobbleaf?\n"
	.string "That's too bad…\p"
	.string "If you get a big Sobbleaf, please\n"
	.string "come show me.$"

SootopolisCity_LotadAndSobbleafHouse_Text_BiggestSobbleafInHistory: @ 8227617
	.string "The biggest Sobbleaf in history!\n"
	.string "{STR_VAR_2}'s {STR_VAR_3}-inch giant!\p"
	.string "A Sobbleaf bigger than a Lotad\n"
	.string "always wanted!$"

SootopolisCity_LotadAndSobbleafHouse_Text_PleaseShowMeBigLotad: @ 8227676
	.string "Do you know the Pokémon Lotad?\n"
	.string "It's rarely seen in Sootopolis.\p"
	.string "I love, I mean love, big Lotad!\p"
	.string "My big brother says that Sobbleaf is\n"
	.string "bigger.\p"
	.string "But that's wrong! Everyone knows that\n"
	.string "Lotad is a lot bigger.\p"
	.string "Hunh? Do you have a Lotad?\n"
	.string "P-p-please show me!$"

SootopolisCity_LotadAndSobbleafHouse_Text_WowMightBeBiggerThanSobbleaf: @ 822776C
	.string "{STR_VAR_2} inches!\n"
	.string "Wow, that is big!\p"
	.string "It might be even bigger than the huge\n"
	.string "Sobbleaf my big brother saw.\p"
	.string "Thanks for showing me!\n"
	.string "This is my thanks!$"

@ Unused
SootopolisCity_LotadAndSobbleafHouse_Text_ReceivedPotion2: @ 82277F4
	.string "{PLAYER} received a Potion.$"

SootopolisCity_LotadAndSobbleafHouse_Text_BagCrammedFull2: @ 822780A
	.string "Hunh?\n"
	.string "Your Bag is crammed full.$"

SootopolisCity_LotadAndSobbleafHouse_Text_SeenBiggerLotad: @ 822782A
	.string "{STR_VAR_2} inches?\p"
	.string "Hmm… I've seen a bigger Lotad\n"
	.string "than this one here.$"

SootopolisCity_LotadAndSobbleafHouse_Text_ThatsNotLotad: @ 8227867
	.string "Well, isn't this something!\n"
	.string "But it's no Lotad!$"

SootopolisCity_LotadAndSobbleafHouse_Text_DontHaveBigLotad: @ 8227896
	.string "Don't you have a big Lotad?\n"
	.string "How disappointing…\p"
	.string "If you get a big Lotad, please\n"
	.string "come show me!$"

SootopolisCity_LotadAndSobbleafHouse_Text_BiggestLotadInHistory: @ 82278F2
	.string "The biggest Lotad in history!\n"
	.string "{STR_VAR_2}'s {STR_VAR_3}-inch colossus!\p"
	.string "A Lotad bigger than a Sobbleaf\n"
	.string "always wanted!$"

