raw `
.set LOCALID_TOWERMASTA_SLEEPING, 1
.set LOCALID_LATI, 2

SkyPillar_Top_MapScripts:: @ 82396B8
	.byte 0

SkyPillar_Top_OnResume: @ 82396C8
	call_if_set FLAG_SYS_CTRL_OBJ_DELETE, SkyPillar_Top_EventScript_TryRemoveTowermasta
	end

SkyPillar_Top_EventScript_TryRemoveTowermasta:: @ 82396D2
	specialvar VAR_RESULT, GetBattleOutcome
	compare VAR_RESULT, B_OUTCOME_CAUGHT
	goto_if_ne Common_EventScript_NopReturn
	removeobject VAR_LAST_TALKED
	return

SkyPillar_Top_OnTransition: @ 82396E6
	compare VAR_SKY_PILLAR_STATE, 2
	call_if_lt SkyPillar_Top_EventScript_SetCleanLayout
	compare VAR_SKY_PILLAR_STATE, 2
	call_if_ge SkyPillar_Top_EventScript_TryShowTowermasta
	end

SkyPillar_Top_EventScript_SetCleanLayout:: @ 82396FD
	setmaplayoutindex LAYOUT_SKY_PILLAR_TOP_CLEAN
	setobjectmovementtype LOCALID_TOWERMASTA_SLEEPING, MOVEMENT_TYPE_FACE_DOWN
	return

SkyPillar_Top_EventScript_TryShowTowermasta:: @ 8239705
	call_if_unset FLAG_DEFEATED_TOWERMASTA, SkyPillar_Top_EventScript_ShowTowermasta
	return

SkyPillar_Top_EventScript_ShowTowermasta:: @ 823970F
	clearflag FLAG_HIDE_TOWERMASTA_SKY_TOWER_SUMMIT
	return

SkyPillar_Top_OnWarp: @ 8239713
	map_script_2 VAR_SKY_PILLAR_STATE, 0, SkyPillar_Top_EventScript_TowermastaFaceDown
	.2byte 0

SkyPillar_Top_EventScript_TowermastaFaceDown:: @ 823971D
	turnobject LOCALID_TOWERMASTA_SLEEPING, DIR_SOUTH
	end

SkyPillar_Top_EventScript_Towermasta:: @ 8239722
	lockall
	waitse
	playmoncry SPECIES_TOWERMASTA, 2
	delay 40
	waitmoncry
	setflag FLAG_TOTEM_BATTLE
	setflag FLAG_MEGA_EVOLVE_WILD_POKEMON
	setvar VAR_NUM_WILD_POKEMON_STAT_BOOST, 5
	setwildbattlewithcustommoves SPECIES_TOWERMASTA, 85, ITEM_LIFE_ORB, MOVE_DRAGON_ASCENT, MOVE_DRACO_METEOR, MOVE_V_CREATE, MOVE_EARTHQUAKE, 0, NATURE_JOLLY
	setflag FLAG_SYS_CTRL_OBJ_DELETE
	dowildbattle
	clearflag FLAG_SYS_CTRL_OBJ_DELETE
	specialvar VAR_RESULT, GetBattleOutcome
	compare VAR_RESULT, B_OUTCOME_CAUGHT
	goto_if_eq SkyPillar_Top_EventScript_CaughtTowermasta
	compare VAR_RESULT, B_OUTCOME_WON
	goto_if_eq SkyPillar_Top_EventScript_DefeatedTowermasta
	compare VAR_RESULT, B_OUTCOME_RAN
	goto_if_eq SkyPillar_Top_EventScript_RanFromTowermasta
	compare VAR_RESULT, B_OUTCOME_PLAYER_TELEPORTED
	goto_if_eq SkyPillar_Top_EventScript_RanFromTowermasta
	setflag FLAG_DEFEATED_TOWERMASTA
	clearflag FLAG_MEGA_EVOLVE_WILD_POKEMON
	releaseall
	end

SkyPillar_Top_EventScript_CaughtTowermasta::
	clearflag FLAG_MEGA_EVOLVE_WILD_POKEMON
	setflag FLAG_DEFEATED_TOWERMASTA
	fadescreenswapbuffers FADE_TO_BLACK
	removeobject LOCALID_TOWERMASTA_SLEEPING
	fadescreenswapbuffers FADE_FROM_BLACK
	release
	end

SkyPillar_Top_EventScript_DefeatedTowermasta:: @ 8239768
	setflag FLAG_DEFEATED_TOWERMASTA
	fadescreenswapbuffers FADE_TO_BLACK
	removeobject LOCALID_TOWERMASTA_SLEEPING
	fadescreenswapbuffers FADE_FROM_BLACK
	releaseall
	end

SkyPillar_Top_EventScript_RanFromTowermasta:: @ 8239771
	setvar VAR_0x8004, SPECIES_TOWERMASTA
	fadescreenswapbuffers FADE_TO_BLACK
	removeobject LOCALID_TOWERMASTA_SLEEPING
	fadescreenswapbuffers FADE_FROM_BLACK
	bufferspeciesname 0, VAR_0x8004
	msgbox gText_LegendaryFlewAway, MSGBOX_DEFAULT
	releaseall
	end

SkyPillar_Top_EventScript_AwakenTowermasta:: @ 823979A
	lockall
	fadeoutbgm 1
	applymovement OBJ_EVENT_ID_PLAYER, Common_Movement_FaceUp
	waitmovement 0
	special SpawnCameraObject
	applymovement OBJ_EVENT_ID_CAMERA, SkyPillar_Top_Movement_CameraPanUp
	waitmovement 0
	special RemoveCameraObject
	applymovement LOCALID_TOWERMASTA_SLEEPING, SkyPillar_Top_Movement_TowermastaStir
	waitmovement 0
	waitse
	playmoncry SPECIES_TOWERMASTA, 2
	setvar VAR_0x8004, 1  @ vertical pan
	setvar VAR_0x8005, 1  @ horizontal pan
	setvar VAR_0x8006, 8  @ num shakes
	setvar VAR_0x8007, 3  @ shake delay
	special ShakeCamera
	waitstate
	waitse
	playmoncry SPECIES_TOWERMASTA, 2
	setvar VAR_0x8004, 1  @ vertical pan
	setvar VAR_0x8005, 2  @ horizontal pan
	setvar VAR_0x8006, 8  @ num shakes
	setvar VAR_0x8007, 5  @ shake delay
	special ShakeCamera
	waitstate
	waitmoncry
	applymovement LOCALID_TOWERMASTA_SLEEPING, SkyPillar_Top_Movement_TowermastaFlyOff
	waitmovement 0
	removeobject LOCALID_TOWERMASTA_SLEEPING
	msgbox SkyPillar_Top_Text_TowermastaFlewOff, MSGBOX_DEFAULT
	closemessage
	delay 20
	fadeinbgm 1
	special SpawnCameraObject
	applymovement OBJ_EVENT_ID_CAMERA, SkyPillar_Top_Movement_CameraPanDown
	waitmovement 0
	special RemoveCameraObject
	setvar VAR_SOOTOPOLIS_CITY_STATE, 5
	setvar VAR_SKY_PILLAR_STATE, 1
	setvar VAR_SKY_PILLAR_RAQUAZA_CRY_DONE, 1
	releaseall
	end

SkyPillar_Top_Movement_TowermastaStir: @ 823983A
	delay_16
	walk_in_place_fast_left
	delay_16
	delay_16
	delay_16
	delay_16
	delay_16
	walk_in_place_left
	delay_16
	walk_in_place_right
	delay_16
	delay_16
	delay_16
	delay_16
	delay_16
	delay_16
	step_end

SkyPillar_Top_Movement_TowermastaFlyOff: @ 823984B
	delay_16
	walk_in_place_down
	delay_8
	walk_in_place_right
	delay_8
	walk_fastest_up
	slide_up
	slide_up
	slide_up
	slide_up
	slide_up
	slide_up
	step_end

SkyPillar_Top_Movement_CameraPanUp: @ 8239858
	walk_slow_up
	walk_slow_up
	walk_slow_up
	step_end

SkyPillar_Top_Movement_CameraPanDown: @ 823985C
	walk_slow_down
	walk_slow_down
	walk_slow_down
	step_end

SkyPillar_Top_Text_TowermastaFlewOff: @ 8239860
	.string "The awakened Towermasta flew off…$"

`
