raw `
EverGrandeCity_ThanatossRoom_MapScripts:: @ 8228412
	map_script MAP_SCRIPT_ON_FRAME_TABLE, EverGrandeCity_ThanatossRoom_OnFrame
	map_script MAP_SCRIPT_ON_LOAD, EverGrandeCity_ThanatossRoom_OnLoad
	map_script MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE, EverGrandeCity_ThanatossRoom_OnWarp
	.byte 0

EverGrandeCity_ThanatossRoom_OnWarp: @ 8228422
	map_script_2 VAR_TEMP_1, 0, EverGrandeCity_ThanatossRoom_EventScript_PlayerTurnNorth
	.2byte 0

EverGrandeCity_ThanatossRoom_EventScript_PlayerTurnNorth:: @ 822842C
	turnobject OBJ_EVENT_ID_PLAYER, DIR_NORTH
	end

EverGrandeCity_ThanatossRoom_OnFrame: @ 8228431
	map_script_2 VAR_ELITE_4_STATE, 2, EverGrandeCity_ThanatossRoom_EventScript_WalkInCloseDoor
	.2byte 0

EverGrandeCity_ThanatossRoom_EventScript_WalkInCloseDoor:: @ 822843B
	lockall
	call PokemonLeague_EliteFour_EventScript_WalkInCloseDoor
	setvar VAR_ELITE_4_STATE, 3
	releaseall
	end

EverGrandeCity_ThanatossRoom_OnLoad: @ 8228448
	call_if_set FLAG_DEFEATED_ELITE_4_THANATOS, EverGrandeCity_ThanatossRoom_EventScript_ResetAdvanceToNextRoom
	compare VAR_ELITE_4_STATE, 3
	call_if_eq EverGrandeCity_ThanatossRoom_EventScript_CloseDoor
	end

EverGrandeCity_ThanatossRoom_EventScript_ResetAdvanceToNextRoom:: @ 822845D
	call PokemonLeague_EliteFour_EventScript_ResetAdvanceToNextRoom
	return

EverGrandeCity_ThanatossRoom_EventScript_CloseDoor:: @ 8228463
	call PokemonLeague_EliteFour_EventScript_CloseDoor
	return

EverGrandeCity_ThanatossRoom_EventScript_Thanatos:: @ 8228469
	lock
	faceplayer
	goto_if_set FLAG_DEFEATED_ELITE_4_THANATOS, EverGrandeCity_ThanatossRoom_EventScript_PostBattleSpeech
	playbgm MUS_ENCOUNTER_ELITE_FOUR, 0
	msgbox EverGrandeCity_ThanatossRoom_Text_IntroSpeech, MSGBOX_DEFAULT
	trainerbattle_no_intro TRAINER_THANATOS, EverGrandeCity_ThanatossRoom_Text_Defeat
	goto EverGrandeCity_ThanatossRoom_EventScript_Defeated
	end

EverGrandeCity_ThanatossRoom_EventScript_PostBattleSpeech:: @ 8228490
	msgbox EverGrandeCity_ThanatossRoom_Text_PostBattleSpeech, MSGBOX_DEFAULT
	release
	end

EverGrandeCity_ThanatossRoom_EventScript_Defeated:: @ 822849A
	setflag FLAG_DEFEATED_ELITE_4_THANATOS
	call PokemonLeague_EliteFour_SetAdvanceToNextRoomMetatiles
	msgbox EverGrandeCity_ThanatossRoom_Text_PostBattleSpeech, MSGBOX_DEFAULT
	release
	end

EverGrandeCity_ThanatossRoom_Text_IntroSpeech: @ 82284AC
	.string "I am Thanatos, the harbinger\n"
	.string "of your defeat. Your Pokémon\n"
	.string "will tremble before death itself.\p"
	.string "Embrace oblivion, for it's\n"
	.string "the only true release.$"

EverGrandeCity_ThanatossRoom_Text_Defeat: @ 82285B4
	.string "You may have won...\n"
	.string "but Death awaits us all.\n"
	.string "This was only temporary.$"

EverGrandeCity_ThanatossRoom_Text_PostBattleSpeech: @ 8228640
	.string "Defeat... a fleeting setback.\n"
	.string "Even the gods fall in time.\n"
	.string "Remember that.$"

`
